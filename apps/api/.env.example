APP_NAME=Dataroom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dataroom
DB_USERNAME=dataroom
DB_PASSWORD=dataroom

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=dataroom
AWS_SECRET_ACCESS_KEY=dataroom-local-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=dataroom-local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

SESSION_DRIVER=database
LOG_CHANNEL=stderr
