APP_NAME=Dataroom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dataroom
DB_USERNAME=dataroom
DB_PASSWORD=dataroom

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# bunny.net Storage. Keep the zone AccessKey server-side only.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
DATAROOM_MAX_UPLOAD_MB=100

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=local-dev-key
MEILISEARCH_INDEX=dataroom_nodes

SESSION_DRIVER=database
LOG_CHANNEL=stderr
